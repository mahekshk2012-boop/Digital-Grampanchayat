rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Complaints evidence photos
    match /complaints/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024 // 10MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Certificate proof documents (PDFs, Images)
    match /certificates/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if request.resource.size < 10 * 1024 * 1024 // 10MB
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    // Profile photos
    match /profiles/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
